# Ignore git details
.git
.gitignore
.gitattributes

# Ignore documentation files
README.md
LICENSE

# Ignore IDE and OS configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Ignore Node.js / React build assets
**/node_modules/
**/build/
**/dist/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignore Java / Maven / Spring Boot build assets
**/target/
**/.settings/
**/.project/
**/.classpath/
**/.factorypath
**/.mvn/wrapper/maven-wrapper.jar
